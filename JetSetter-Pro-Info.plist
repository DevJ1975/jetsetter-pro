<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode's generated Info.plist only forwards a fixed set of INFOPLIST_KEY_*
	     build settings. Everything below was silently dropped when it lived in
	     project.pbxproj as INFOPLIST_KEY_…, so background polling never
	     registered and no API_* value ever reached AppSecrets. This file is
	     merged into the generated plist with build-setting expansion, so
	     $(API_…) resolves from Config/Secrets.xcconfig when it's wired as the
	     base configuration, and to an empty string (= not configured) otherwise. -->

	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.jetsetter.pro.disruption.poll</string>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>uber</string>
		<string>lyft</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>

	<!-- Every orientation, on iPhone and iPad. The foldable iPhone Ultra's
	     inner display reports a regular size class and is used in landscape,
	     and iOS 27 makes iPhone apps resizable, so layout follows the space
	     the scene gets rather than a locked portrait frame. The app used to be
	     portrait-only on iPhone. UIRequiresFullScreen is deliberately absent:
	     it is deprecated in iOS 26 and would opt the app out of resizing.
	     The target's INFOPLIST_KEY_UISupportedInterfaceOrientations build
	     setting lists the same four orientations, so the two sources agree.
	     The scene manifest is
	     generated (INFOPLIST_KEY_UIApplicationSceneManifest_Generation) and
	     the SwiftUI App lifecycle supplies the scene, so none is declared here. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- jetsetterpro:// deep links (trip/next, trip/new, flight/<number>,
	     wallet/pass/<id>), used by the widget, the Live Activity and the
	     backend's push `deepLink` key. Parsed by Shared/JetSetterDeepLink.swift. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>DevJ.JetSetter-Pro</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>jetsetterpro</string>
			</array>
		</dict>
	</array>

	<!-- Required before the first Core Motion call or iOS terminates the app:
	     CMPedometer (AirportMapViewModel, walking time to the gate) and
	     CMAltimeter (InFlightTrackingService, climb and descent). Keep the
	     wording in step with what those two services actually read. -->
	<key>NSMotionUsageDescription</key>
	<string>JetSetter Pro counts your steps to estimate your walking time to the gate and reads air pressure to show your flight's climb and descent.</string>

	<!-- Optional credentials (see Config/Secrets.xcconfig.example). -->
	<key>API_FLIGHTAWARE</key>
	<string>$(API_FLIGHTAWARE)</string>
	<key>API_BACKEND_URL</key>
	<string>$(API_BACKEND_URL)</string>
	<key>API_EXPENSIFY_PARTNER_KEY</key>
	<string>$(API_EXPENSIFY_PARTNER_KEY)</string>
	<key>API_RAMP_CLIENT_ID</key>
	<string>$(API_RAMP_CLIENT_ID)</string>
	<key>API_RAMP_CLIENT_SECRET</key>
	<string>$(API_RAMP_CLIENT_SECRET)</string>
	<key>API_BREX_CLIENT_ID</key>
	<string>$(API_BREX_CLIENT_ID)</string>
	<key>API_DIVVY_CLIENT_ID</key>
	<string>$(API_DIVVY_CLIENT_ID)</string>
	<key>API_BILL_SPEND_TOKEN</key>
	<string>$(API_BILL_SPEND_TOKEN)</string>
</dict>
</plist>
