# Copy to .env (gitignored) and fill in. Never commit real values.

# Duffel access token — Duffel dashboard → Developers → Access tokens.
# Use a TEST token first (duffel_test_...); switch to live only in production.
DUFFEL_ACCESS_TOKEN=

# Shared secret the iOS app sends as `Authorization: Bearer <key>`.
# Generate a long random string, e.g.:  openssl rand -hex 32
PROXY_APP_KEY=

# Port to listen on. Most hosts (Cloud Run, Render, Fly, Heroku) set this for you.
PORT=8080
