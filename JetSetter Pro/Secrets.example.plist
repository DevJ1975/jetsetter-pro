<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Secrets.example.plist  —  TEMPLATE (safe to commit)

  HOW TO USE
  ──────────
  1. Duplicate this file in the same folder and rename the copy to:
         Secrets.plist
  2. Replace each "YOUR_…" placeholder with a real value.
  3. Secrets.plist is git-ignored, so your real keys never get committed.

  Notes
  ─────
  • SUPABASE_ANON_KEY is safe to ship in the app (it is protected by
    Row-Level Security on the server).
  • The Anthropic key is intentionally absent: it lives only in the
    server-side Claude proxy edge function, never in the app binary.
  • In demo mode (MockDataService.isEnabled == true) none of these are
    used, so you can leave Secrets.plist absent while developing.
-->
<plist version="1.0">
<dict>
    <!-- Supabase (anon key is RLS-protected and safe to bundle) -->
    <key>SUPABASE_URL</key>
    <string>https://YOUR_PROJECT_ID.supabase.co</string>
    <key>SUPABASE_ANON_KEY</key>
    <string>YOUR_SUPABASE_ANON_KEY</string>

    <!-- Optional: override the Claude proxy URL.
         If omitted, it defaults to <SUPABASE_URL>/functions/v1/claude-proxy -->
    <key>CLAUDE_PROXY_URL</key>
    <string></string>

    <!-- Third-party services -->
    <key>FLIGHTAWARE_API_KEY</key>
    <string>YOUR_FLIGHTAWARE_API_KEY</string>
    <key>EXPEDIA_CLIENT_ID</key>
    <string>YOUR_EXPEDIA_CLIENT_ID</string>
    <key>EXPEDIA_CLIENT_SECRET</key>
    <string>YOUR_EXPEDIA_CLIENT_SECRET</string>
    <key>UBER_SERVER_TOKEN</key>
    <string>YOUR_UBER_SERVER_TOKEN</string>
    <key>LYFT_CLIENT_ID</key>
    <string>YOUR_LYFT_CLIENT_ID</string>
    <key>LYFT_CLIENT_SECRET</key>
    <string>YOUR_LYFT_CLIENT_SECRET</string>
    <key>GOOGLE_VISION_API_KEY</key>
    <string>YOUR_GOOGLE_VISION_API_KEY</string>
    <key>SITA_WORLDTRACER_PARTNER_KEY</key>
    <string>YOUR_SITA_WORLDTRACER_PARTNER_KEY</string>
    <key>ENTERPRISE_API_KEY</key>
    <string>YOUR_ENTERPRISE_API_KEY</string>
    <key>HERTZ_API_KEY</key>
    <string>YOUR_HERTZ_API_KEY</string>
    <key>NATIONAL_API_KEY</key>
    <string>YOUR_NATIONAL_API_KEY</string>

    <!-- Flight data & rebooking -->
    <key>FLIGHTAWARE_AEROAPI_KEY</key>
    <string>YOUR_FLIGHTAWARE_AEROAPI_KEY</string>
    <key>AMADEUS_CLIENT_ID</key>
    <string>YOUR_AMADEUS_CLIENT_ID</string>
    <key>AMADEUS_CLIENT_SECRET</key>
    <string>YOUR_AMADEUS_CLIENT_SECRET</string>
    <key>DUFFEL_API_TOKEN</key>
    <string>YOUR_DUFFEL_API_TOKEN</string>
</dict>
</plist>
