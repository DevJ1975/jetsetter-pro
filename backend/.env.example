# Copy to .env for local work (python manage.py ... with `set -a; . .env; set +a`).
# On Railway set these as service variables; never commit real values.

DJANGO_SECRET_KEY=          # openssl rand -hex 32   (required in production)
DJANGO_DEBUG=0              # 1 only on your laptop
# DATABASE_URL is injected by Railway's Postgres plugin (reference ${{Postgres.DATABASE_URL}}).
# PUBLIC_BASE_URL defaults to https://$RAILWAY_PUBLIC_DOMAIN; set it when you add a custom domain.
PUBLIC_BASE_URL=
DJANGO_ALLOWED_HOSTS=       # extra hosts, comma separated (custom domain)

# Duffel (flights). duffel_test_... = fake bookings, free. duffel_live_... = real money.
DUFFEL_ACCESS_TOKEN=
DUFFEL_WEBHOOK_SECRET=      # from the Duffel webhook you create pointing at /webhooks/duffel/

# Stripe (taking payment). Leave empty while testing on a Duffel test token.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=      # whsec_... for the endpoint /webhooks/stripe/

# Optional markup on top of the airline price
SERVICE_FEE_PERCENT=0
SERVICE_FEE_FIXED=0

# Shown on the privacy/terms/support pages
COMPANY_NAME=
SUPPORT_EMAIL=
