// Secrets.xcconfig.example
//
// Copy this file to Secrets.xcconfig (same directory) and fill in real values.
// Secrets.xcconfig is gitignored — never commit real credentials.
//
// Wire-up steps (one-time, in Xcode):
//   1. File → Add Files… → select Secrets.xcconfig (uncheck "Copy items if needed").
//   2. Project navigator → JetSetter Pro project → Info tab → Configurations →
//      for BOTH Debug and Release, set the project-level config dropdown to
//      "Secrets" (this file). Targets inherit it.
//   3. Build. INFOPLIST_KEY_* entries in the target pull these values into Info.plist.
//
// Each empty value disables the corresponding feature's live calls and falls
// back to mock data — safe to leave blank during development.

// ── Flights ──────────────────────────────────────────────────────────────────
API_FLIGHTAWARE =

// ── AI ───────────────────────────────────────────────────────────────────────
API_ANTHROPIC =

// ── Hotels (Expedia Partner Solutions Rapid) ────────────────────────────────
// The Expedia API key + shared secret are full-account credentials and now live
// ONLY on the proxy (server/duffel-proxy env: EXPEDIA_CLIENT_ID / _SECRET). The
// app fetches the signed EAN auth header from the proxy — nothing to set here.

// ── Ground Transport ─────────────────────────────────────────────────────────
API_UBER_SERVER_TOKEN =
API_LYFT_CLIENT_ID =
API_LYFT_CLIENT_SECRET =

// ── Receipt OCR (Google Vision) ──────────────────────────────────────────────
API_GOOGLE_VISION =

// ── Luggage (SITA WorldTracer) ───────────────────────────────────────────────
API_SITA_WORLDTRACER =

// ── Rental Cars ──────────────────────────────────────────────────────────────
API_ENTERPRISE =
API_HERTZ =
API_NATIONAL =

// ── Check-in / Rebooking (Amadeus + Duffel) ─────────────────────────────────
// Amadeus is a direct client integration; Duffel is proxy-only (the Duffel
// token lives on the server, never here — see the Duffel proxy section below).
API_AMADEUS_CLIENT_ID =
API_AMADEUS_CLIENT_SECRET =

// ── Duffel proxy (token stays server-side — see server/duffel-proxy) ─────────
// The app calls the proxy, never Duffel directly. URL = deployed proxy host;
// KEY = the same value as the proxy's PROXY_APP_KEY env var.
API_DUFFEL_PROXY_URL =
API_DUFFEL_PROXY_KEY =

// ── Supabase backend (shared cross-platform data + auth) ────────────────────
// The active backend. From Supabase dashboard → Project Settings → API:
//   URL      = Project URL (https://<ref>.supabase.co)
//   ANON KEY = the public "anon" / publishable key (safe to embed; data
//              isolation is enforced by Row-Level Security — see supabase/).
// Leave blank to run against mock data (SupabaseService no-ops when unset).
API_SUPABASE_URL =
API_SUPABASE_ANON_KEY =

// ── Firebase backend (RETIRED — replaced by Supabase above) ─────────────────
// Kept only for reference; the app no longer uses Firebase for data/auth.
// See IOS_PARITY_NOTES.md §1. Leave blank.
API_FIREBASE_PROJECT_ID =
API_FIREBASE_API_KEY =

// ── Expense providers ────────────────────────────────────────────────────────
// Expensify Integration Server: developers.expensify.com → Integration Server
API_EXPENSIFY_PARTNER_KEY =
// Ramp / Brex / Divvy OAuth — apply at each platform's developer portal
API_RAMP_CLIENT_ID =
API_RAMP_CLIENT_SECRET =
API_BREX_CLIENT_ID =
API_DIVVY_CLIENT_ID =
